# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=no-reply@otobrix.ai

# Next.js Configuration
NEXT_PUBLIC_CSP_ENABLED=true
NEXT_PUBLIC_HSTS_ENABLED=true
DISABLE_CSRF=false

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Next.js Configuration
NEXT_PUBLIC_CACHE_ENABLED=true
NEXT_PUBLIC_ISR_ENABLED=true

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
ENABLE_REDIS_CACHE=false
ENABLE_UPSTASH_QUEUE=false
ENABLE_CACHE=true

# Error Tracking
SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id
SENTRY_ENVIRONMENT=development

# Next.js Configuration
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id

# Error Tracking
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING=true

# Caching
CACHE_TTL_DASHBOARD=3600
CACHE_TTL_CLIENTS=3600
CACHE_TTL_SESSIONS=3600

# Vercel Deployment
VERCEL_OIDC_TOKEN=your_vercel_oidc_token_here
