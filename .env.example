# ──────────────────────────────────────────────────────────────
# 1. Local / N8N Integration
# ──────────────────────────────────────────────────────────────
N8N_BASE_URL=your-url-here
N8N_WEBHOOK_SECRET=your-secret-key-here
ADMIN_API_KEY=your-secret-key-here
ADMIN_SESSION_SECRET=your-secret-key-here
ADMIN_LOGIN_PATH_SEGMENT=your-value-here
ADMIN_INIT_PASSWORD=your-secret-key-here
CLIENT_INIT_PASSWORD=your-secret-key-here
AUTH_NO_LOGS=your-value-here

# ──────────────────────────────────────────────────────────────
# 2. Database (Superbase)
# ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:6543/postgres?sslmode=no-verify"
# Direct connection for migrations and Prisma Studio
DIRECT_URL="postgresql://username:password@localhost:6543/postgres?sslmode=no-verify"

# For connection pooling with PgBouncer (Production)
DATABASE_URL_WITH_POOLER="postgresql://username:password@localhost:6543/postgres?pgbouncer=true&connect_timeout=15&pool_timeout=15&connection_limit=10"
CRON_SECRET=your-value-here

# ──────────────────────────────────────────────────────────────
# 3. Public URLs
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=your-url-here
NEXT_PUBLIC_APP_URL=your-url-here

# ──────────────────────────────────────────────────────────────
# 4. NextAuth.js
# ──────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
CLIENT_DASHBOARD_URL=your-url-here
APP_NAME=your-value-here
SUPPORT_EMAIL=your-email@example.com
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# ──────────────────────────────────────────────────────────────
# 5. Email (Resend + SMTP fallback)
# ──────────────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=your-email@example.com

SMTP_HOST=your-value-here
SMTP_PORT=your-value-here
SMTP_USER=your-value-here
SMTP_PASSWORD=your-secret-key-here
SMTP_FROM_EMAIL=your-email@example.com

# ──────────────────────────────────────────────────────────────
# 6. Security Headers
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CSP_ENABLED=your-value-here
NEXT_PUBLIC_HSTS_ENABLED=your-value-here

# ──────────────────────────────────────────────────────────────
# 7. Rate Limiting
# ──────────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=your-value-here
RATE_LIMIT_WINDOW_MS=your-value-here

# ──────────────────────────────────────────────────────────────
# 8. Performance / Caching
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CACHE_ENABLED=your-value-here
NEXT_PUBLIC_ISR_ENABLED=your-value-here

# ──────────────────────────────────────────────────────────────
# 9. Node Environment
# ──────────────────────────────────────────────────────────────
NODE_ENV=your-value-here

# ──────────────────────────────────────────────────────────────
# 10. Redis Environment
# ──────────────────────────────────────────────────────────────
# Add to .env.local

# Upstash Redis Configuration
UPSTASH_REDIS_REST_URL="your-upstash-redis-rest-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"
ENABLE_REDIS_CACHE=your-value-here
ENABLE_UPSTASH_QUEUE=your-value-here
ENABLE_CACHE=true

# ─────────────────────────────────────────────────────────
# 11. SENTRY ENVIRONMENT
# ─────────────────────────────────────────────────────────
SENTRY_DSN=your-value-here
SENTRY_ENVIRONMENT=your-value-here
NEXT_PUBLIC_SENTRY_DSN=your-value-here
SENTRY_ORG=your-value-here
SENTRY_PROJECT=your-value-here
SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING=your-value-here


# Cache TTLs (in seconds)
CACHE_TTL_DASHBOARD=300
CACHE_TTL_CLIENTS=180
CACHE_TTL_SESSIONS=1800


# ──────────────────────────────────────────────────────────────
# 12. Build & Performance Optimization
# ──────────────────────────────────────────────────────────────
ANALYZE=false
NEXT_PUBLIC_PROFILE=false
NEXT_TELEMETRY_DISABLED=1

# Disable Redis for local dev if needed
DISABLE_REDIS=false
REDIS_TIMEOUT_MS=5000

# Build optimization flags
NEXT_OPTIMIZE_FONTS=true
NEXT_OPTIMIZE_IMAGES=true
NEXT_OPTIMIZE_CSS=true

# Memory limits for build (for Vercel)
NODE_OPTIONS="--max-old-space-size=4096"

# Enable React production mode
REACT_EDITOR=none
