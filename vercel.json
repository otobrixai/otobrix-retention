{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "regions": ["iad1"],
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "redirects": [
    { 
      "source": "/", 
      "destination": "https://automation.otobrixai.com", 
      "permanent": true 
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { 
          "key": "Strict-Transport-Security", 
          "value": "max-age=63072000; includeSubDomains; preload" 
        }
      ]
    }
  ]
}