# pnpm configuration
# Use strict peer dependencies to prevent phantom dependencies
strict-peer-dependencies=false
# Auto install peers (Next.js and React ecosystem work better with this)
auto-install-peers=true
# Use shamefully-hoist for better compatibility with some tools
# This is often needed for Next.js and tools that expect node_modules structure
shamefully-hoist=false
# Store location (optional, uses default if not set)
# store-dir=~/.pnpm-store
