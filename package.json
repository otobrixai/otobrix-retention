{
  "name": "otobrix-retention",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:reset": "prisma migrate reset --force && prisma generate && prisma db seed",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npx prisma db push && npx prisma generate",
    "db:refresh-rfm": "tsx scripts/refresh-rfm-view.ts",
    "db:test-data": "tsx scripts/test-utils.ts --data",
    "db:check-rfm": "tsx scripts/test-utils.ts --rfm",
    "health:rfm": "npx tsx scripts/check-rfm-health.ts",
    "health:rfm:watch": "nodemon --watch scripts --ext ts --exec npx tsx scripts/check-rfm-health.ts",
    "health:prod": "CRON_SECRET=your-secret npx tsx scripts/monitor-production.ts",
    "start:ci": "next start -p 3000",
    "test": "vitest run __tests__/secure.test.ts",
    "test:watch": "vitest --watch __tests__/secure.test.ts",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:infrastructure": "tsx scripts/test-utils.ts",
    "test:env": "tsx scripts/test-utils.ts --env",
    "test:db": "tsx scripts/test-utils.ts --db",
    "test:cache": "tsx scripts/test-utils.ts --cache",
    "test:cache-health": "tsx scripts/test-utils.ts --cache-health",
    "test:rfm": "tsx scripts/test-utils.ts --rfm",
    "test:swr-cache": "tsx scripts/test-swr-cache.ts",
    "test:dashboard": "tsx scripts/test-utils.ts --dashboard",
    "smoke:health": "node scripts/smoke/health-check.js",
    "smoke:metrics": "node scripts/smoke/simple-metrics-test.js",
    "smoke:rate-limit": "node scripts/smoke/rate-limit-test.js",
    "smoke:csrf": "node scripts/smoke/csrf-test.js",
    "smoke:sentry": "node scripts/smoke/sentry-test.js",
    "smoke:all": "node scripts/smoke/run-all.js",
    "test:all-suites": "npm run test:infrastructure && npm run smoke:all",
    "test:full": "npm run test:coverage && npm run test:infrastructure && npm run smoke:all",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:browser": "cross-env ANALYZE_MODE=browser ANALYZE=true next build",
    "analyze:server": "cross-env ANALYZE_MODE=server ANALYZE=true next build",
    "optimize": "node scripts/optimize-build.js",
    "clear-cache": "tsx scripts/clear-cache.ts",
    "worker": "tsx scripts/worker.ts",
    "k6:smoke": "k6 run scripts/k6-smoke-test.js",
    "k6:dashboard": "k6 run scripts/k6-dashboard-test.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@prisma/adapter-pg": "^7.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.31.0",
    "@tanstack/react-query": "^5.90.9",
    "@upstash/redis": "^1.35.6",
    "autoprefixer": "^10.4.22",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "lru-cache": "^11.2.2",
    "lucide-react": "^0.555.0",
    "next": "16.1.0",
    "next-auth": "^5.0.0-beta.19",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": "^19.2.3",
    "recharts": "^3.5.0",
    "resend": "^6.4.2",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@prisma/client": "6.19.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.19.27",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitest/coverage-v8": "^4.0.9",
    "@vitest/ui": "^4.0.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.7",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "nodemon": "^3.1.11",
    "prisma": "6.19.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
